{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --no-env-file --watch index.ts",
    "start": "bun --no-env-file index.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "db:setup": "bun --no-env-file src/scripts/setupDb.ts",
    "db:seed": "bun --no-env-file src/scripts/seedDb.ts",
    "admin:provision": "bun --no-env-file src/scripts/provisionAdmin.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  }
}
